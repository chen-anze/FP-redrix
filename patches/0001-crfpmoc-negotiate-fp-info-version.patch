+static void
+crfpmoc_open_fp_info_version_cb (CrfpMocEcTransfer *transfer,
+                                 GAsyncResult      *res,
+                                 gpointer           user_data)
+{
+  g_autoptr(GError) error = NULL;
+  FpiSsm *ssm = user_data;
+  FpiDeviceCrfpMoc *self = FPI_DEVICE_CRFPMOC (fpi_ssm_get_device (ssm));
+  struct crfpmoc_ec_response_get_cmd_versions *versions;
+
+  if (!crfpmoc_ec_transfer_submit_finish (res, &error))
+    {
+      g_prefix_error_literal (&error, "Failed to query FP_INFO versions: ");
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+      return;
+    }
+
+  versions = transfer->indata;
+  if (versions->version_mask & BIT (3))
+    self->fp_info_version = 3;
+  else if (versions->version_mask & BIT (2))
+    self->fp_info_version = 2;
+  else if (versions->version_mask & BIT (1))
+    self->fp_info_version = 1;
+  else
+    {
+      fpi_ssm_mark_failed (ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                     "No supported FP_INFO version in mask 0x%x",
+                                                     versions->version_mask));
+      return;
+    }
+
+  fp_dbg ("Using EC_CMD_FP_INFO version %u", self->fp_info_version);
+  fpi_ssm_next_state (ssm);
+}
